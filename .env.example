# === Aplicação ===
DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=troque-por-uma-chave-segura-em-producao
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Origens confiáveis para CSRF (obrigatório em produção com HTTPS).
# Ex.: CSRF_TRUSTED_ORIGINS=https://dutratech.cloud,https://www.dutratech.cloud
CSRF_TRUSTED_ORIGINS=

# === Deploy (docker-compose.prod.yml + Caddy) ===
# Domínio usado pelo Caddy para o certificado HTTPS (Let's Encrypt).
DOMAIN=dutratech.cloud

# === Banco de dados ===
# Local: deixe POSTGRES_HOST vazio para usar SQLite (dev).
# Docker/produção: defina POSTGRES_HOST=db (o docker-compose já injeta essas variáveis).
POSTGRES_DB=associacao
POSTGRES_USER=associacao
POSTGRES_PASSWORD=associacao
POSTGRES_HOST=
POSTGRES_PORT=5432

# === Identidade da associação (aparece no site e no payload PIX) ===
ASSOCIACAO_NOME=Associação Comercial
ASSOCIACAO_CIDADE=SAO PAULO
ASSOCIACAO_UF=SP
ASSOCIACAO_TELEFONE=(11) 3000-0000
ASSOCIACAO_EMAIL=contato@associacao.com.br

# === Chave PIX estática (payload copia-e-cola) ===
# Aceita: CPF/CNPJ (só números), e-mail, telefone (+55...) ou chave aleatória UUID
ASSOCIACAO_PIX_CHAVE=

# === Valores dos serviços (BRL) ===
TAXA_ASSOCIACAO_VALOR=120.00
CERTIFICADO_DIGITAL_VALOR=350.00

# === Consulta CPF/CNPJ ===
# BrasilAPI é gratuita para CNPJ. Para CPF, configure um provider autorizado (ex.: Serpro).
CONSULTA_RATE_LIMIT=10
CONSULTA_CACHE_HORAS=24
SERPRO_API_TOKEN=
SERPRO_API_URL=

# === E-mail (dev: console) ===
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@associacao.com.br
